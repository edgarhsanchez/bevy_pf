<!-- Fluent Light — palette source: https://github.com/microsoft/microsoft-ui-xaml/blob/main/controls/dev/CommonStyles/Common_themeresources_any.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Pf.WindowBackground" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Pf.PanelBackground" Color="#FBFBFB"/>
  <SolidColorBrush x:Key="Pf.ControlBackground" Color="#FBFBFB"/>
  <SolidColorBrush x:Key="Pf.ControlHoverBackground" Color="#F6F6F6"/>
  <SolidColorBrush x:Key="Pf.ControlPressedBackground" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="Pf.BorderBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="Pf.TextBrush" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="Pf.TextMutedBrush" Color="#5C5C5C"/>
  <SolidColorBrush x:Key="Pf.AccentBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="Pf.AccentTextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Pf.InputBackground" Color="#FBFBFB"/>
  <SolidColorBrush x:Key="Pf.SelectionBrush" Color="#0078D4"/>
  <SolidColorBrush x:Key="Pf.SuccessBrush" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="Pf.WarningBrush" Color="#9D5D00"/>
  <SolidColorBrush x:Key="Pf.ErrorBrush" Color="#C42B1C"/>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Pf.WindowBackground}"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Pf.AccentBrush}"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Pf.ControlBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Pf.ControlHoverBackground}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Pf.ControlPressedBackground}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}" />
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Pf.InputBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Pf.ControlBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="TreeView">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextMutedBrush}"/>
  </Style>
  <Style TargetType="ToolBar">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="Calendar">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="DatePicker">
    <Setter Property="Background" Value="{DynamicResource Pf.InputBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
</ResourceDictionary>
