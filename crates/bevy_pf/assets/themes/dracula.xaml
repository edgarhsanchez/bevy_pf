<!-- Dracula — palette source: https://draculatheme.com/contribute -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Pf.WindowBackground" Color="#282A36"/>
  <SolidColorBrush x:Key="Pf.PanelBackground" Color="#282A36"/>
  <SolidColorBrush x:Key="Pf.ControlBackground" Color="#44475A"/>
  <SolidColorBrush x:Key="Pf.ControlHoverBackground" Color="#535C7F"/>
  <SolidColorBrush x:Key="Pf.ControlPressedBackground" Color="#363848"/>
  <SolidColorBrush x:Key="Pf.BorderBrush" Color="#6272A4"/>
  <SolidColorBrush x:Key="Pf.TextBrush" Color="#F8F8F2"/>
  <SolidColorBrush x:Key="Pf.TextMutedBrush" Color="#6272A4"/>
  <SolidColorBrush x:Key="Pf.AccentBrush" Color="#BD93F9"/>
  <SolidColorBrush x:Key="Pf.AccentTextBrush" Color="#282A36"/>
  <SolidColorBrush x:Key="Pf.InputBackground" Color="#282A36"/>
  <SolidColorBrush x:Key="Pf.SelectionBrush" Color="#44475A"/>
  <SolidColorBrush x:Key="Pf.SuccessBrush" Color="#50FA7B"/>
  <SolidColorBrush x:Key="Pf.WarningBrush" Color="#FFB86C"/>
  <SolidColorBrush x:Key="Pf.ErrorBrush" Color="#FF5555"/>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Pf.WindowBackground}"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Pf.AccentBrush}"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Pf.ControlBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Pf.ControlHoverBackground}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Pf.ControlPressedBackground}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}" />
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Pf.InputBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Pf.ControlBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="TreeView">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextMutedBrush}"/>
  </Style>
  <Style TargetType="ToolBar">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="Calendar">
    <Setter Property="Background" Value="{DynamicResource Pf.PanelBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
  <Style TargetType="DatePicker">
    <Setter Property="Background" Value="{DynamicResource Pf.InputBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Pf.TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Pf.BorderBrush}"/>
  </Style>
</ResourceDictionary>
