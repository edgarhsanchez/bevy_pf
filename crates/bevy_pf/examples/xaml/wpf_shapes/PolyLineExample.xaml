<!-- This example shows how to draw Polyline elements. -->
<Page     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Polyline Example">
  <Page.Resources>
    <!-- Adaptation: the original App.xaml graph-paper DrawingBrushes become
         solid brushes; MyGridBorderStyle's class-qualified setters become a
         TargetType style. -->
    <SolidColorBrush x:Key="MyGridBrushResource" Color="White"/>
    <SolidColorBrush x:Key="MyGrayGridBrushResource" Color="#EEEEEE"/>
    <Style x:Key="MyGridBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource MyGridBrushResource}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="BorderBrush" Value="Black"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="400"/>
    </Style>
  </Page.Resources>

<StackPanel>
  <Border>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
        <LinearGradientBrush.GradientStops>
          <GradientStop Color="#CCCCFF" Offset="0" />
          <GradientStop Color="AliceBlue" Offset="0.25" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>
    </Border.Background>
    <TextBlock Margin="10" HorizontalAlignment="Left"> 
      Polyline Examples
    </TextBlock>
  </Border>    

  <StackPanel Margin="10">
    <Border Style="{StaticResource MyGridBorderStyle}">
      <Canvas Height="400" Width="400">


        <Polyline
          Points="10,110 60,10 110,110"
          Stroke="Black"
          StrokeThickness="4" />

        <Polyline
          Points="10,110 110,110 110,10"
          Stroke="Black"
          StrokeThickness="4"
          Canvas.Left="150" />


        </Canvas>
      </Border>
    </StackPanel>
  </StackPanel>
</Page>
