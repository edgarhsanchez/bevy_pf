<!-- This example shows how to use the FillRule property of
   Polygon and Path elements. -->
<Page     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fill Rule Example">
  <Page.Resources>
    <!-- Adaptation: the original App.xaml graph-paper DrawingBrushes become
         solid brushes; MyGridBorderStyle's class-qualified setters become a
         TargetType style. -->
    <SolidColorBrush x:Key="MyGridBrushResource" Color="White"/>
    <SolidColorBrush x:Key="MyGrayGridBrushResource" Color="#EEEEEE"/>
    <Style x:Key="MyGridBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource MyGridBrushResource}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="BorderBrush" Value="Black"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="400"/>
    </Style>
  </Page.Resources>

<StackPanel>    
  <Border>
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
        <LinearGradientBrush.GradientStops>
          <GradientStop Color="#CCCCFF" Offset="0" />
          <GradientStop Color="AliceBlue" Offset="0.25" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>
    </Border.Background>
    <TextBlock Margin="10" HorizontalAlignment="Left"> 
      FillRule Examples
    </TextBlock>
  </Border>  

  <StackPanel Margin="10">

    <Canvas Margin="20">

      <!-- Polygon A -->
      <Polygon
        Points="10,100 50,0 90,100 0,35 100,35"
        Fill="Gold"
        Stroke="Black"
        StrokeThickness="3"
        FillRule="Nonzero"
        Canvas.Top="20" />


        <!-- Polygon B -->

      <Polygon
        Points="10,100 50,0 90,100 0,35 100,35"
        Fill="Gold"
        Stroke="Black"
        StrokeThickness="3"
        FillRule="EvenOdd"
        Canvas.Left="150"
        Canvas.Top="20" />


        <!-- Labels -->
    <TextBlock Canvas.Left="0" Canvas.Top="0">NonZero</TextBlock>
    <TextBlock Canvas.Left="150" Canvas.Top="0">EvenOdd</TextBlock>

  </Canvas>
</StackPanel>
</StackPanel>
</Page>
