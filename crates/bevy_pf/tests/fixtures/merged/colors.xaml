<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Accent">#FF0078D7</Color>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.Overridden" Color="Red"/>
  <SolidColorBrush x:Key="Brush.FromColors" Color="Teal"/>
</ResourceDictionary>
